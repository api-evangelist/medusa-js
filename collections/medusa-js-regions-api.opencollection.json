{
  "opencollection": "1.0.0",
  "info": {
    "name": "Medusa Store Auth Regions API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-publishable-api-key",
      "value": "{{x-publishable-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Regions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{medusaApplicationUrl}/store/regions"
          },
          "docs": "List regions"
        },
        {
          "info": {
            "name": "Get a region",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{medusaApplicationUrl}/store/regions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a region"
        }
      ]
    }
  ],
  "bundled": true
}